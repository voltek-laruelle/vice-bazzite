#!/usr/bin/env bash
# Auto-generated wrapper: re-execute the HOST's real 'cloudflared' through
# flatpak-spawn, since it cannot (or should not) run inside the sandbox.
# vice calls "cloudflared" by bare name via subprocess/shutil.which, so having
# this on $PATH ahead of nothing-else makes it transparent.
exec flatpak-spawn --host cloudflared "$@"
